{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blago:uel:0.1-lab.1:event",
  "title": "UEL offline inert observation envelope; schema is not authority validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "body",
    "signature"
  ],
  "properties": {
    "alg": {
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_epoch",
        "authority_ref",
        "created_at",
        "disclosure",
        "event_id",
        "issuer",
        "issuer_key",
        "issuer_role",
        "kind",
        "network",
        "object",
        "object_version",
        "parents",
        "payload_b64",
        "payload_hash",
        "payload_schema",
        "policy_ref",
        "previous",
        "profile",
        "schema",
        "subject",
        "type"
      ],
      "properties": {
        "profile": {
          "const": "uel-0.1-lab.1"
        },
        "kind": {
          "const": "event"
        },
        "network": {
          "type": "string",
          "pattern": "^fd:[0-9a-f]{32}$"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^ev:[0-9a-f]{64}$"
        },
        "type": {
          "const": "source.observation"
        },
        "schema": {
          "const": "blago.inert-observation-frame.v1"
        },
        "issuer": {
          "type": "string",
          "pattern": "^nd:[0-9a-f]{32}$"
        },
        "issuer_key": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "issuer_role": {
          "const": "NODE"
        },
        "subject": {
          "type": "string",
          "pattern": "^ps:[0-9a-f]{32}$"
        },
        "object": {
          "type": "string",
          "pattern": "^ob:[0-9a-f]{64}$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "authority_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "disclosure": {
          "const": "FEDERATED"
        },
        "payload_schema": {
          "const": "text.utf8.v1"
        },
        "payload_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 2731
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Canonical lexical form, duplicate keys, sorted parents, base64 re-encoding, payload hash and Ed25519/pins need independent byte inspector. This schema alone does NOT authorize disclosure/actions."
}
