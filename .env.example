TELEGRAM_BOT_TOKEN=
XBLAGO_LLM_PROVIDER=local
# For Hugging Face: hf, Qwen/Qwen3-14B:cheapest, HF_TOKEN or XBLAGO_LLM_API_KEY
XBLAGO_LLM_MODEL=gpt-5-mini
XBLAGO_LLM_API_KEY=
# Used when XBLAGO_LLM_PROVIDER=hf (keep empty unless enabled)
HF_TOKEN=
XBLAGO_LLM_BASE_URL=https://api.openai.com/v1
XBLAGO_LLM_TIMEOUT_SECONDS=30
XBLAGO_LLM_MAX_TOKENS=384

# Foundation 02 - pilot only. Never commit a real invitation code.
XBLAGO_WEB_INVITE_CODE=
XBLAGO_COOKIE_SECURE=true
